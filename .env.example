# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Variable names are this project's own convention. Phase 1 confirms which
# credentials the Betfair login method actually needs.
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_APP_KEY=
# Folder holding the client certificate for non-interactive login, if used.
BETFAIR_CERTS_DIR=
